# ============================================================
# AgriScan AI – Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agriscan_db
DB_USER=root
DB_PASSWORD=Manish@123

# Upload Config
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# ML Model
MODEL_PATH=../ml/agriscan_model.h5
CLASSES_PATH=../ml/classes.json
DISEASE_INFO_PATH=../ml/disease_info.json

# Email (for Forgot Password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Weather API (https://openweathermap.org/api - Free tier)
WEATHER_API_KEY=your_openweathermap_api_key

# Admin Default Credentials (used in seed)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@agriscan.ai
ADMIN_PASSWORD=Admin@123
